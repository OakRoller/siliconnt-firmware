# BootRamdiskHelperDxe.inf: Registers the boot disk image the device tree names as a RAM disk.
# Copyright (c) amarioguy (Arminder Singh), 2022.
[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = BootRamdiskHelperDxe
  FILE_GUID                      = 69b5dbd8-92c0-492c-859f-7256d5100d2a
  MODULE_TYPE                    = DXE_DRIVER
  VERSION_STRING                 = 1.0
  ENTRY_POINT                    = BootRamdiskHelperDxeInitialize

[Sources.common]
  BootRamdiskHelperDxe.c
  BootRamdiskHelperDxe.h

[Packages]
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  AppleSiliconPkg/AppleSiliconPkg.dec

[LibraryClasses]
  UefiDriverEntryPoint
  UefiBootServicesTableLib
  DebugLib
  AppleDTLib

[Protocols]
  gEfiRamDiskProtocolGuid                         ## CONSUMES

[Guids]
  gEfiVirtualDiskGuid                             ## CONSUMES ## GUID

# RamDiskDxe must have run: the entry point calls its protocol
[Depex]
  gEfiRamDiskProtocolGuid
